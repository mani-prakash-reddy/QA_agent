# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="QA Agent"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# --- QA Agent ---
REDIS_URL=redis://localhost:6379
# Fernet key that encrypts role credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys (newest first) to rotate.
CREDENTIAL_ENCRYPTION_KEY=
# Hosts the crawler may target (comma-separated). Private IP literals are rejected unless listed.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,frontend,juice-shop

# Chat LLM: any OpenAI-compatible endpoint (e.g. Groq: https://api.groq.com/openai/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

# Embeddings: any OpenAI-compatible endpoint (e.g. OpenRouter: https://openrouter.ai/api/v1)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIM=1536
# Azure OpenAI embeddings (used instead of the endpoint above when all of these are set; 1536-d ada-002)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
